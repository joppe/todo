{
  "tasks": {
    "dev": "REPO_FILE=./data/todos.json deno run --watch --allow-read=./data/todos.json --allow-write=./data/todos.json -E src/cli.ts",
    "start": "REPO_FILE=./data/todos.json deno run --allow-read=./data/todos.json --allow-write=./data/todos.json -E src/cli.ts",
    "build": "REPO_FILE=~/todo/todos.json deno compile --allow-read=~/todo/todos.json --allow-write=~/todo/todos.json --output=./bin/todo -E src/cli.ts"
  },
  "imports": {
    "@clap/": "./src/clap/",
    "@faker-js/faker": "npm:@faker-js/faker@^9.7.0",
    "@gateways/": "./src/gateways/",
    "@std/assert": "jsr:@std/assert@^1.0.12",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/testing": "jsr:@std/testing@^1.0.11",
    "@std/uuid": "jsr:@std/uuid@^1.0.6",
    "@todo/": "./src/modules/todo/",
    "@utils/": "./src/utils/"
  }
}
